CONFIG_64BIT=y
CONFIG_X86_64=y
# x86-64 only: ARCH=horn defines no IA32 or x32 compatibility option.
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_COMPAT is not set
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_TTY=y
CONFIG_HVC_DRIVER=y
CONFIG_HORN_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_EPOLL=y
CONFIG_FUTEX=y
CONFIG_IKCONFIG=n
CONFIG_MODULES=n
CONFIG_LOCALVERSION="-horn"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_STACKTRACE=y
CONFIG_DEBUG_KERNEL=y
CONFIG_RCU_CPU_STALL_TIMEOUT=60
